// Title: VMs with no Azure Backup
// Source: Resource Graph
// Tables: resources, recoveryservicesresources
// When to use: Backup coverage check across every subscription at once.
// Tune: VMs tagged backup-exempt=true are skipped.

resources
| where type =~ 'microsoft.compute/virtualmachines'
| where tostring(tags['backup-exempt']) != 'true'
| project vmId = tolower(id), VmName = name, resourceGroup, subscriptionId
| join kind=leftouter (
    recoveryservicesresources
    | where type =~ 'microsoft.recoveryservices/vaults/backupfabrics/protectioncontainers/protecteditems'
    | where tostring(properties.workloadType) =~ 'VM'
    | project vmId = tolower(tostring(properties.sourceResourceId)), ProtectionState = tostring(properties.protectionState)
  ) on vmId
| where isempty(ProtectionState) or ProtectionState =~ 'ProtectionStopped'
| project VmName, ProtectionState = iff(isempty(ProtectionState), 'None', ProtectionState), resourceGroup, subscriptionId
